{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": {
		"enabled": true,
		"clientKind": "git",
		"useIgnoreFile": true
	},
	"files": {
		"ignoreUnknown": true,
		"includes": [
			"**",
			"!node_modules",
			"!dist",
			"!build",
			"!.next",
			"!.agents"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"indentWidth": 4
	},
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"suspicious": {
				"noUnknownAtRules": "off",
				"noArrayIndexKey": "warn"
			},
			"style": {
				"useImportType": "off"
			},
			"nursery": {
				"useSortedClasses": "warn"
			}
		},
		"domains": {
			"next": "recommended",
			"react": "recommended",
			"drizzle": "recommended"
		}
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": {
					"level": "on",
					"options": {
						"groups": [
							[":NODE:", ":BUN:"],
							":BLANK_LINE:",
							[":PACKAGE:", ":PACKAGE_WITH_PROTOCOL:", ":URL:"],
							":BLANK_LINE:",
							":ALIAS:",
							":BLANK_LINE:",
							":PATH:"
						]
					}
				}
			}
		}
	},
	"javascript": {
		"parser": {
			"unsafeParameterDecoratorsEnabled": true
		}
	},
	"css": {
		"parser": {
			"tailwindDirectives": true
		}
	},
	"overrides": [
		{
			"includes": ["**/*.spec.ts", "**/*.test.ts", "**/*.mock.ts"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					}
				}
			}
		},
		{
			"includes": ["components/ui/**", "components/ai-elements/**"],
			"linter": {
				"rules": {
					"performance": {
						"noImgElement": "off"
					},
					"suspicious": {
						"noArrayIndexKey": "off"
					},
					"a11y": {
						"useSemanticElements": "off",
						"useAriaPropsForRole": "off",
						"useFocusableInteractive": "off",
						"useKeyWithClickEvents": "off",
						"noLabelWithoutControl": "off"
					}
				}
			}
		}
	]
}
